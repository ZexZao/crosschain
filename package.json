{
  "name": "crosschain-trusted-transport-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "TEE-quorum trusted messaging across Ethereum, Fabric, and Avalanche",
  "scripts": {
    "node": "hardhat node",
    "compile": "hardhat compile",
    "test": "npm run test:node && npm run test:hardhat",
    "test:node": "node --test test/avalanche-pchain-trust.test.js",
    "test:hardhat": "hardhat test test/tee-subnet-cryptographic-isolation.test.js",
    "deploy": "hardhat run scripts/deploy.js --network localhost",
    "deploy:sepolia": "DEPLOYMENT_OUTPUT_FILE=deployment.sepolia.json hardhat run scripts/deploy.js --network sepolia",
    "sepolia:register:tee-subnets": "node scripts/register-sepolia-tee-subnets.js",
    "hxmsg:test:challenge": "hardhat run scripts/run-challenge-response-tests.js",
    "hxmsg:test:checkpoint": "hardhat run scripts/run-lifecycle-checkpoint-tests.js",
    "hxmsg:test:forgery": "node scripts/run-hxmsg-forgery-attack-tests.js",
    "sepolia:sync-committee": "node scripts/run-sepolia-sync-committee-check.js",
    "sepolia:test:evm-fabric": "node scripts/run-sepolia-evm-fabric-test.js",
    "sepolia:test:fabric-evm": "node scripts/run-sepolia-fabric-evm-test.js",
    "sepolia:test:avalanche-sepolia": "node scripts/run-avalanche-sepolia-warp-test.js",
    "sepolia:test:sepolia-avalanche": "node scripts/run-sepolia-avalanche-warp-test.js",
    "sepolia:test:four-directions:preflight": "node scripts/run-sepolia-four-direction-preflight.js",
    "sepolia:test:four-directions": "node scripts/run-sepolia-four-direction-tests.js",
    "raft:test": "node scripts/run-raft-cluster-tests.js",
    "avalanche:up": "PATH=$HOME/bin:$PATH avalanche network start --num-nodes 5 --skip-update-check && node scripts/generate-avalanche-pchain-trust-anchor.js",
    "avalanche:anchor": "node scripts/generate-avalanche-pchain-trust-anchor.js",
    "avalanche:test:pchain-anchor": "node --test test/avalanche-pchain-trust.test.js",
    "avalanche:down": "PATH=$HOME/bin:$PATH avalanche network stop --skip-update-check",
    "avalanche:status": "PATH=$HOME/bin:$PATH avalanche network status --skip-update-check",
    "deploy:avalanche": "node scripts/deploy-avalanche-local.js",
    "fabric:wallet": "node scripts/export-fabric-wallet.js",
    "fabric:cc:deploy": "docker compose -f docker-compose.fabric.yml run --rm fabric-tools bash /fabric-network/fabric-network/scripts/deploy-chaincode.sh",
    "tee": "node tee-verifier/server.js",
    "automation": "node automation/server.js",
    "automation:up": "docker compose up -d automation",
    "automation:down": "docker compose stop automation",
    "automation:test:ethereum-avalanche": "node scripts/run-automation-evm-evm-e2e.js",
    "automation:test:ethereum-avalanche:oracle": "node scripts/run-automation-ethereum-avalanche-oracle-e2e.js",
    "automation:test:avalanche-ethereum": "node scripts/run-automation-avalanche-evm-e2e.js",
    "automation:test:evm-fabric": "node scripts/run-automation-evm-fabric-e2e.js",
    "automation:test:fabric-evm": "node scripts/run-automation-fabric-evm-e2e.js",
    "automation:test:batch:ethereum-fabric": "node scripts/run-automation-ethereum-fabric-batch-experiments.js",
    "automation:test:batch:ethereum-avalanche": "node scripts/run-automation-ethereum-avalanche-batch-experiments.js",
    "automation:test:batch:fabric-avalanche": "node scripts/run-automation-fabric-avalanche-batch-experiments.js",
    "automation:test:batch:fabric-avalanche:atomic": "node scripts/run-automation-fabric-avalanche-atomic-batch.js",
    "automation:test:batch:ethereum-fabric:atomic": "AUTOMATION_FABRIC_EVM_PEER=ethereum node scripts/run-automation-fabric-avalanche-atomic-batch.js",
    "automation:test:batch:ethereum-avalanche:atomic": "node scripts/run-automation-ethereum-avalanche-atomic-batch.js",
    "automation:test:challenge:ethereum-avalanche": "node scripts/run-automation-ethereum-avalanche-challenge-rollback.js",
    "automation:test:challenge:ethereum-fabric": "AUTOMATION_FABRIC_EVM_PEER=ethereum node scripts/run-automation-fabric-evm-challenge-rollback.js",
    "automation:test:challenge:fabric-avalanche": "AUTOMATION_FABRIC_EVM_PEER=avalanche node scripts/run-automation-fabric-evm-challenge-rollback.js",
    "automation:test:watcher-escrow": "node scripts/run-automation-watcher-escrow-e2e.js",
    "automation:test:store": "node scripts/run-automation-store-tests.js",
    "fabric:up": "docker compose -f docker-compose.fabric.yml up -d fabric-ca.org1.example.com orderer.example.com peer0.org1.example.com peer1.org1.example.com peer2.org1.example.com peer3.org1.example.com",
    "pair:up": "node scripts/manage-chain-pair.js up",
    "pair:down": "node scripts/manage-chain-pair.js down",
    "fabric:channel": "docker compose -f docker-compose.fabric.yml run --rm fabric-tools bash /fabric-network/fabric-network/scripts/create-channel.sh",
    "fabric:down": "docker compose -f docker-compose.fabric.yml down -v"
  },
  "dependencies": {
    "@avalabs/avalanchejs": "^5.1.0",
    "@chainsafe/bls": "^7.1.3",
    "@chainsafe/ssz": "^1.2.1",
    "@ethereumjs/rlp": "^10.1.1",
    "@ethereumjs/trie": "^6.2.1",
    "@ethereumjs/util": "^10.1.1",
    "@noble/curves": "^2.2.0",
    "axios": "^1.8.1",
    "ethers": "^6.13.5",
    "express": "^4.21.2",
    "fabric-network": "^2.2.20",
    "fs-extra": "^11.3.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.22.18"
  }
}
