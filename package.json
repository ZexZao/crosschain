{
  "name": "crosschain-trusted-transport-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal prototype for trusted cross-chain data transport experiments",
  "scripts": {
    "node": "hardhat node",
    "compile": "hardhat compile",
    "deploy": "hardhat run scripts/deploy.js --network localhost",
    "fabric:test": "node scripts/run-hxmsg-forward-tests.js",
    "fabric:test:forward": "node scripts/run-hxmsg-forward-tests.js",
    "hxmsg:test:forward": "node scripts/run-hxmsg-forward-tests.js",
    "hxmsg:test:evm-fabric": "node scripts/run-evm-fabric-tests.js",
    "hxmsg:test:challenge": "hardhat run scripts/run-challenge-response-tests.js",
    "hxmsg:test:challenge:fabric-evm": "node scripts/run-fabric-evm-challenge-e2e.js",
    "hxmsg:test:challenge:evm-fabric": "node scripts/run-evm-fabric-challenge-e2e.js",
    "hxmsg:test:asset": "node scripts/run-asset-transfer-refund-tests.js",
    "hxmsg:test:forgery": "node scripts/run-hxmsg-forgery-attack-tests.js",
    "hxmsg:test:avalanche": "node scripts/run-avalanche-ethereum-warp-test.js",
    "hxmsg:test:avalanche-fabric": "AVALANCHE_TARGET_KIND=fabric AVALANCHE_TARGET_LABEL=FABRIC AVALANCHE_ETHEREUM_TEST_TYPE=avalanche-to-fabric-real-warp AVALANCHE_ETHEREUM_RESULT_FILE=avalanche-fabric-warp-test-result.json node scripts/run-avalanche-ethereum-warp-test.js",
    "hxmsg:test:fabric-avalanche": "HXMSG_TARGET_CHAIN_TYPE=AVALANCHE TARGET_EVM_RPC=http://127.0.0.1:9650/ext/bc/C/rpc TARGET_EVM_PRIVATE_KEY=0x56289e99c94b6912bfc12adc093c9b51124f0dc54ac7a766b2bc5ccf558d8027 TARGET_EVM_DEPLOYMENT_FILE=runtime/avalanche-deployment.json HXMSG_RESULTS_FILE=hxmsg-fabric-avalanche-results.json HXMSG_SUMMARY_FILE=hxmsg-fabric-avalanche-summary.md node scripts/run-hxmsg-forward-tests.js",
    "sepolia:sync-committee": "node scripts/run-sepolia-sync-committee-check.js",
    "sepolia:test:evm-fabric": "node scripts/run-sepolia-evm-fabric-test.js",
    "sepolia:test:fabric-evm": "node scripts/run-sepolia-fabric-evm-test.js",
    "sepolia:test:avalanche-evm": "node scripts/run-avalanche-sepolia-warp-test.js",
    "sepolia:test:evm-avalanche": "node scripts/run-sepolia-avalanche-warp-test.js",
    "sepolia:test:avalanche-sepolia": "node scripts/run-avalanche-sepolia-warp-test.js",
    "sepolia:test:sepolia-avalanche": "node scripts/run-sepolia-avalanche-warp-test.js",
    "local:test:evm-avalanche-response": "node scripts/run-local-evm-avalanche-response-gas-test.js",
    "local:test:evm-avalanche-no-response": "node scripts/run-local-evm-avalanche-no-response-cases.js",
    "local:test:evm-avalanche-asset-batch": "NO_RESPONSE_CASE_FILE=test-cases/asset-transfer-batch-cases.json NO_RESPONSE_RESULT_FILE=local-evm-avalanche-asset-transfer-batch-results.json NO_RESPONSE_SUMMARY_FILE=local-evm-avalanche-asset-transfer-batch-summary.md HXMSG_TEE_BATCH_SIZE=8 node scripts/run-local-evm-avalanche-no-response-cases.js",
    "raft:test": "node scripts/run-raft-cluster-tests.js",
    "avalanche:up": "PATH=$HOME/bin:$PATH avalanche network start --num-nodes 5 --skip-update-check",
    "avalanche:down": "PATH=$HOME/bin:$PATH avalanche network stop --skip-update-check",
    "avalanche:status": "PATH=$HOME/bin:$PATH avalanche network status --skip-update-check",
    "deploy:avalanche": "node scripts/deploy-avalanche-local.js",
    "avalanche:smoke": "node scripts/run-avalanche-local-source-smoke.js",
    "avalanche:test:ethereum": "node scripts/run-avalanche-ethereum-warp-test.js",
    "evm:fabric:request": "node scripts/request-evm-fabric-call.js",
    "fabric:wallet": "node scripts/export-fabric-wallet.js",
    "fabric:cc:deploy": "docker compose -f docker-compose.fabric.yml run --rm fabric-tools bash /fabric-network/fabric-network/scripts/deploy-chaincode.sh",
    "fabric:cc:invoke": "docker compose -f docker-compose.fabric.yml run --rm fabric-tools bash /fabric-network/fabric-network/scripts/invoke-xcall.sh",
    "tee": "node tee-verifier/server.js",
    "fabric:up": "docker compose -f docker-compose.fabric.yml up -d fabric-ca.org1.example.com orderer.example.com peer0.org1.example.com peer1.org1.example.com peer2.org1.example.com peer3.org1.example.com",
    "evm:up": "docker compose up -d evm-node tee-verifier tee-verifier-2 tee-verifier-3 tee-verifier-4 tee-verifier-5 tee-fabric-1 tee-fabric-2 tee-fabric-3 tee-fabric-4 tee-fabric-5 tee-avalanche-1 tee-avalanche-2 tee-avalanche-3 tee-avalanche-4 tee-avalanche-5",
    "pair:up": "node scripts/manage-chain-pair.js up",
    "pair:down": "node scripts/manage-chain-pair.js down",
    "fabric:channel": "docker compose -f docker-compose.fabric.yml run --rm fabric-tools bash /fabric-network/fabric-network/scripts/create-channel.sh",
    "fabric:down": "docker compose -f docker-compose.fabric.yml down -v",
    "exp:normal": "node scripts/run-hxmsg-forward-tests.js",
    "start": "node -e \"console.log('Use Ubuntu flow: npm run deploy && npm run hxmsg:test:forward after Fabric/EVM/TEE are up')\"",
    "start:full": "npm run start",
    "start:forward": "npm run hxmsg:test:forward",
    "test:hybrid": "node scripts/run-hxmsg-forward-tests.js"
  },
  "dependencies": {
    "@avalabs/avalanchejs": "^5.1.0",
    "@chainsafe/bls": "^7.1.3",
    "@chainsafe/ssz": "^1.2.1",
    "@ethereumjs/rlp": "^10.1.1",
    "@ethereumjs/trie": "^6.2.1",
    "@ethereumjs/util": "^10.1.1",
    "@noble/curves": "^2.2.0",
    "axios": "^1.8.1",
    "ethers": "^6.13.5",
    "express": "^4.21.2",
    "fabric-network": "^2.2.20",
    "fs-extra": "^11.3.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.22.18"
  }
}
